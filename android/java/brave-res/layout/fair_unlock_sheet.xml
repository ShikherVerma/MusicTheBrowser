<?xml version="1.0" encoding="utf-8"?>
<!-- Music Browser: a count-only Carbon purchase sheet; rows grow with font size. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/fair_app_name" android:textSize="12sp"
            android:textColor="@color/text_secondary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/fair_unlock_title"
            android:textSize="20sp" android:accessibilityHeading="true"
            android:textColor="@color/text_primary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/fair_unlock_body"
            android:textSize="16sp" android:textColor="@color/text_primary" />
        <TextView android:id="@+id/fair_unlock_count" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:fontFamily="monospace" android:textSize="14sp"
            android:textColor="@color/text_secondary" />
        <Button android:id="@+id/fair_unlock_buy" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:layout_marginTop="16dp" android:textAllCaps="false"
            android:textColor="#ffffff" android:padding="16dp" android:gravity="start|center_vertical"
            android:background="@color/button_background" />
        <ProgressBar android:id="@+id/fair_unlock_progress" android:layout_width="24dp"
            android:layout_height="24dp" android:layout_marginTop="8dp"
            android:indeterminateTint="@color/text_interactive" android:visibility="gone" />
        <TextView android:id="@+id/fair_unlock_error" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:textSize="12sp" android:textColor="@color/text_secondary"
            android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/fair_unlock_restore" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/fair_restore_purchase" android:textAllCaps="false"
            android:padding="16dp" android:gravity="start|center_vertical"
            android:textColor="@color/text_interactive" android:background="?android:attr/selectableItemBackground" />
        <Button android:id="@+id/fair_unlock_later" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/fair_unlock_later" android:textAllCaps="false"
            android:padding="16dp" android:gravity="start|center_vertical"
            android:textColor="@color/text_interactive" android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>
</ScrollView>
