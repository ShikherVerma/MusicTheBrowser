<?xml version="1.0" encoding="utf-8"?>
<!-- Music Browser: four-dp square scrubber, using the native SeekBar's gestures. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical" android:height="4dp">
        <shape><solid android:color="@color/fair_player_layer" /></shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical" android:height="4dp">
        <clip><shape><solid android:color="@color/playlist_progress_bar_tint" /></shape></clip>
    </item>
</layer-list>
